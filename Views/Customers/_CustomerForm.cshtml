@model Customer
@{
    var users = ViewData["AssignableUsers"] as SelectList;
}
<input asp-for="Id" type="hidden" />
<input asp-for="RowVersion" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="form-section-title"><span>Contact details</span><small>Fields marked with * are required.</small></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" autocomplete="family-name" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" autocomplete="organization" /><span asp-validation-for="CompanyName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<CustomerStatus>()" class="form-select"></select></div>
    <div class="col-md-3"><label asp-for="OwnerId" class="form-label"></label><select asp-for="OwnerId" asp-items="users" class="form-select"><option value="">Select owner</option></select><span asp-validation-for="OwnerId" class="text-danger"></span></div>
</div>
<div class="form-section-title mt-4"><span>Address</span><small>Optional customer location.</small></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="AddressLine1" class="form-label"></label><input asp-for="AddressLine1" class="form-control" autocomplete="address-line1" /></div>
    <div class="col-md-6"><label asp-for="AddressLine2" class="form-label"></label><input asp-for="AddressLine2" class="form-control" autocomplete="address-line2" /></div>
    <div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" autocomplete="address-level2" /></div>
    <div class="col-md-4"><label asp-for="State" class="form-label"></label><input asp-for="State" class="form-control" autocomplete="address-level1" /></div>
    <div class="col-md-4"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" autocomplete="postal-code" /></div>
    <div class="col-md-6"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" autocomplete="country-name" /></div>
    <div class="col-md-6"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" placeholder="Relationship notes, preferences, or context"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
</div>
