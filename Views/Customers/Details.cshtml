@model Customer
@{
    ViewData["Title"] = Model.DisplayName;
}
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Customers</a><div class="d-flex align-items-center gap-3"><span class="profile-avatar">@Model.DisplayName[..1].ToUpperInvariant()</span><div><h2>@Model.DisplayName</h2><p>@(Model.CompanyName ?? "Individual customer") · @Model.Email</p></div></div></div>
    <div class="d-flex gap-2"><a asp-controller="Activities" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Follow-up</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a></div>
</div>
<section class="row g-4">
    <div class="col-lg-4"><article class="content-card h-100"><div class="card-heading"><div><h3>Customer details</h3><p><span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></p></div></div><dl class="detail-list"><div><dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd></div><div><dt>Phone</dt><dd>@(Model.Phone ?? "Not provided")</dd></div><div><dt>Address</dt><dd>@string.Join(", ", new[] { Model.AddressLine1, Model.AddressLine2, Model.City, Model.State, Model.PostalCode, Model.Country }.Where(value => !string.IsNullOrWhiteSpace(value)))</dd></div><div><dt>Owner</dt><dd>@(Model.Owner?.DisplayName ?? "Unassigned")</dd></div><div><dt>Added</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="note-box"><strong>Notes</strong><p>@Model.Notes</p></div> }</article></div>
    <div class="col-lg-8"><article class="content-card mb-4"><div class="card-heading"><div><h3>Opportunities</h3><p>Revenue connected to this customer.</p></div><a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Id" class="text-link">Add opportunity <i class="bi bi-arrow-right"></i></a></div>@if (!Model.Opportunities.Any()) { <div class="empty-state compact"><i class="bi bi-kanban"></i><strong>No opportunities yet</strong><span>Create an opportunity when a sales conversation begins.</span></div> } else { <div class="pipeline-list">@foreach (var opportunity in Model.Opportunities.OrderByDescending(item => item.Amount)) { <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opportunity.Id" class="pipeline-row"><span><strong>@opportunity.Name</strong><small>@opportunity.Stage · @opportunity.Probability% probability</small></span><strong>@opportunity.Amount.ToString("C0")</strong></a> }</div> }</article>
    <article class="content-card"><div class="card-heading"><div><h3>Recent activity</h3><p>Latest notes and follow-ups.</p></div></div>@if (!Model.Activities.Any()) { <div class="empty-state compact"><i class="bi bi-clock-history"></i><strong>No activity recorded</strong><span>Add a note or follow-up to capture the next step.</span></div> } else { <div class="activity-list">@foreach (var activity in Model.Activities) { <a asp-controller="Activities" asp-action="Details" asp-route-id="@activity.Id" class="activity-row"><span class="activity-type"><i class="bi bi-check2-square"></i></span><span class="activity-copy"><strong>@activity.Subject</strong><small>@activity.Status · @activity.CreatedAt.ToLocalTime().ToString("dd MMM")</small></span><span class="due-copy"><strong>@(activity.DueAt?.ToLocalTime().ToString("dd MMM") ?? "—")</strong></span></a> }</div> }</article></div>
</section>
