@model IEnumerable<AuditLog>
@{ ViewData["Title"] = "Audit log"; var entity = ViewData["Entity"] as string; var action = ViewData["Action"] as AuditAction?; var entities = ViewData["Entities"] as IEnumerable<string> ?? Array.Empty<string>(); }
<div class="page-heading mb-4"><span class="section-kicker"><i class="bi bi-journal-text"></i> Administration</span><h2>Audit log</h2><p>Review important business and security events. The latest 250 records are shown.</p></div><section class="content-card"><form method="get" class="filter-bar"><select name="entity" class="form-select"><option value="">All entities</option>@foreach(var item in entities) { <option value="@item" selected="@(item == entity)">@item</option> }</select><select name="action" class="form-select"><option value="">All actions</option>@foreach(var item in Html.GetEnumSelectList<AuditAction>()) { <option value="@item.Value" selected="@(item.Value == ((int?)action)?.ToString())">@item.Text</option> }</select><button class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button></form><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th><th>IP address</th></tr></thead><tbody>@if(!Model.Any()) { <tr><td colspan="6"><div class="empty-state"><i class="bi bi-journal-x"></i><strong>No matching audit records</strong><span>Business and security actions will appear here.</span></div></td></tr> } @foreach(var log in Model) { <tr><td>@log.Timestamp.ToLocalTime().ToString("dd MMM yyyy, h:mm:ss tt")</td><td>@(log.User?.DisplayName ?? "System")</td><td><span class="status-badge status-prospect">@log.Action</span></td><td><strong>@log.EntityName</strong>@if(!string.IsNullOrWhiteSpace(log.EntityId)) { <small class="d-block">#@log.EntityId</small> }</td><td class="text-wrap" style="max-width:360px">@log.Details</td><td>@(log.IpAddress ?? "—")</td></tr> }</tbody></table></div></section>
