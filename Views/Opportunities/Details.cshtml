@model Opportunity
@{ ViewData["Title"] = Model.Name; var relatedName = Model.Customer?.DisplayName ?? Model.Lead?.CompanyName ?? (Model.Lead is not null ? Model.Lead.FirstName + " " + Model.Lead.LastName : "—"); }
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4"><div><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Opportunities</a><h2>@Model.Name</h2><p>@relatedName · @Model.Amount.ToString("C0")</p></div><div class="d-flex gap-2"><a asp-controller="Activities" asp-action="Create" asp-route-opportunityId="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Follow-up</a><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a></div></div><section class="row g-4"><div class="col-lg-4"><article class="content-card h-100"><div class="card-heading"><div><h3>Deal snapshot</h3><p><span class="status-badge status-@Model.Stage.ToString().ToLowerInvariant()">@Model.Stage</span></p></div></div><dl class="detail-list"><div><dt>Amount</dt><dd>@Model.Amount.ToString("C2")</dd></div><div><dt>Probability</dt><dd>@Model.Probability%</dd></div><div><dt>Expected close</dt><dd>@Model.ExpectedCloseDate.ToLocalTime().ToString("dd MMM yyyy")</dd></div><div><dt>Actual close</dt><dd>@(Model.ActualCloseDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "Not closed")</dd></div><div><dt>Account</dt><dd>@relatedName</dd></div><div><dt>Owner</dt><dd>@(Model.AssignedToUser?.DisplayName ?? "Unassigned")</dd></div></dl>@if(!string.IsNullOrWhiteSpace(Model.Description)) { <div class="note-box"><strong>Description</strong><p>@Model.Description</p></div> }</article></div><div class="col-lg-8"><article class="content-card"><div class="card-heading"><div><h3>Activity timeline</h3><p>Every next action and update for this deal.</p></div></div>@if(!Model.Activities.Any()) { <div class="empty-state compact"><i class="bi bi-clock-history"></i><strong>No deal activity yet</strong><span>Add a follow-up to preserve the next best action.</span></div> } else { <div class="activity-list">@foreach(var activity in Model.Activities) { <a asp-controller="Activities" asp-action="Details" asp-route-id="@activity.Id" class="activity-row"><span class="activity-type"><i class="bi bi-check2-square"></i></span><span class="activity-copy"><strong>@activity.Subject</strong><small>@activity.Status · @activity.CreatedAt.ToLocalTime().ToString("dd MMM")</small></span><span class="due-copy"><strong>@(activity.DueAt?.ToLocalTime().ToString("dd MMM") ?? "—")</strong></span></a> }</div> }</article></div></section>
