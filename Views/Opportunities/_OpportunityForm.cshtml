@model Opportunity
@{ var customers = ViewData["Customers"] as SelectList; var leads = ViewData["Leads"] as SelectList; var users = ViewData["AssignableUsers"] as SelectList; }
<input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="form-section-title"><span>Opportunity details</span><small>Connect a deal to a customer or qualified lead.</small></div><div class="row g-3"><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Enterprise renewal FY27" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" min="0.01" step="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" asp-items="customers" class="form-select"><option value="">No customer selected</option></select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead</label><select asp-for="LeadId" asp-items="leads" class="form-select"><option value="">No lead selected</option></select><span asp-validation-for="LeadId" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3" placeholder="Scope, stakeholders, or commercial context"></textarea></div></div>
<div class="form-section-title mt-4"><span>Forecast &amp; ownership</span><small>Closed stages automatically set the correct win probability.</small></div><div class="row g-3"><div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" asp-items="Html.GetEnumSelectList<OpportunityStage>()" class="form-select" data-opportunity-stage></select></div><div class="col-md-4"><label asp-for="Probability" class="form-label"></label><div class="input-group"><input asp-for="Probability" class="form-control" min="0" max="100" /><span class="input-group-text">%</span></div><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ActualCloseDate" class="form-label"></label><input asp-for="ActualCloseDate" class="form-control" /><small class="form-text">Set automatically when a deal is closed.</small></div><div class="col-md-6"><label asp-for="AssignedToUserId" class="form-label"></label><select asp-for="AssignedToUserId" asp-items="users" class="form-select"><option value="">Select assignee</option></select><span asp-validation-for="AssignedToUserId" class="text-danger"></span></div></div>
