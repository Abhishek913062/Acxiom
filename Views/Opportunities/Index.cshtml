@model IEnumerable<Opportunity>
@{ ViewData["Title"] = "Opportunities"; var search = ViewData["Search"] as string; var selected = ViewData["Stage"] as OpportunityStage?; }
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4"><div><span class="section-kicker"><i class="bi bi-kanban-fill"></i> Sales execution</span><h2>Opportunities</h2><p>Focus the team on the deals most likely to move forward.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New opportunity</a></div><section class="content-card"><form method="get" class="filter-bar"><div class="search-control"><i class="bi bi-search"></i><input name="search" value="@search" type="search" placeholder="Search opportunity or account" /></div><select name="stage" class="form-select"><option value="">All stages</option>@foreach(var option in Html.GetEnumSelectList<OpportunityStage>()) { <option value="@option.Value" selected="@(option.Value == ((int?)selected)?.ToString())">@option.Text</option> }</select><button class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button></form><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>Opportunity</th><th>Account</th><th>Stage</th><th>Value</th><th>Close date</th><th>Owner</th><th class="text-end">Actions</th></tr></thead><tbody>@if(!Model.Any()) { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-kanban"></i><strong>No opportunities found</strong><span>Add a deal to start tracking your sales pipeline.</span></div></td></tr> } @foreach(var item in Model) { <tr><td><a asp-action="Details" asp-route-id="@item.Id" class="table-primary-link"><span class="initial-avatar"><i class="bi bi-briefcase-fill"></i></span><span><strong>@item.Name</strong><small>@item.Probability% win probability</small></span></a></td><td>@(item.Customer?.DisplayName ?? item.Lead?.CompanyName ?? (item.Lead is not null ? item.Lead.FirstName + " " + item.Lead.LastName : "—"))</td><td><span class="status-badge status-@item.Stage.ToString().ToLowerInvariant()">@item.Stage</span></td><td><strong>@item.Amount.ToString("C0")</strong></td><td>@item.ExpectedCloseDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@(item.AssignedToUser?.DisplayName ?? "Unassigned")</td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></div></td></tr> }</tbody></table></div></section>
