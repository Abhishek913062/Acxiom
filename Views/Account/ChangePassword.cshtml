@model AcxiomCRM.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
    ViewData["PageTitle"] = "Change password";
    ViewData["Section"] = "Account";
}

<div class="page-header">
    <div>
        <span class="eyebrow">Account security</span>
        <h2>Change your password</h2>
        <p>Use a unique, strong password to keep your CRM data protected.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-7 col-lg-8">
        <div class="app-card">
            <div class="app-card-header">
                <div>
                    <h3><i class="bi bi-key-fill me-2 text-primary"></i>Password details</h3>
                    <p>Your session will stay active after the password is updated.</p>
                </div>
            </div>
            <div class="app-card-body">
                <form asp-action="ChangePassword" method="post" aria-label="Change password form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label required"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                            <button class="btn btn-light border" type="button" data-password-toggle="#CurrentPassword" aria-label="Show current password" aria-pressed="false"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label required"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                            <button class="btn btn-light border" type="button" data-password-toggle="#NewPassword" aria-label="Show new password" aria-pressed="false"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <div class="form-text">At least 8 characters with uppercase, lowercase, a number, and a symbol.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label required"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <button class="btn btn-light border" type="button" data-password-toggle="#ConfirmPassword" aria-label="Show password confirmation" aria-pressed="false"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i> Update password</button>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-light">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
