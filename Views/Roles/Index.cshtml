@model IEnumerable<AcxiomCRM.ViewModels.RoleSummaryViewModel>
@{ ViewData["Title"] = "Roles & access"; }
<div class="page-heading mb-4"><span class="section-kicker"><i class="bi bi-shield-lock-fill"></i> Administration</span><h2>Roles &amp; access</h2><p>Use the three protected CRM roles to govern data visibility and operational access.</p></div><section class="row g-4"><div class="col-lg-4"><article class="content-card h-100"><h3>Add custom role</h3><p class="text-muted">Custom roles can be created for future use. Core CRM roles remain protected.</p><form asp-action="Create" method="post"><div class="mb-3"><label class="form-label" for="Name">Role name</label><input class="form-control" id="Name" name="Name" maxlength="100" placeholder="e.g. Read Only" required /></div><button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg"></i> Create role</button></form></article></div><div class="col-lg-8"><article class="content-card h-100"><div class="card-heading"><div><h3>Configured roles</h3><p>Assignments are managed from individual user settings.</p></div></div><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>Role</th><th>Members</th><th>Protection</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var role in Model) { <tr><td><strong>@role.Name</strong></td><td>@role.Members</td><td>@if(role.IsCoreRole) { <span class="status-badge status-active">Core role</span> } else { <span class="status-badge status-prospect">Custom</span> }</td><td class="text-end">@if(!role.IsCoreRole) { <form asp-action="Delete" method="post" class="d-inline"><input type="hidden" name="id" value="@role.Id" /><button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Delete this unused role?"><i class="bi bi-trash3"></i></button></form> }</td></tr> }</tbody></table></div></article></div></section>
