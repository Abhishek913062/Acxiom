@model Lead
@{
    var users = ViewData["AssignableUsers"] as SelectList;
}
<input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="form-section-title"><span>Lead profile</span><small>Capture what your team needs for the next conversation.</small></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="JobTitle" class="form-label"></label><input asp-for="JobTitle" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Source" class="form-label"></label><select asp-for="Source" asp-items="Html.GetEnumSelectList<LeadSource>()" class="form-select"></select></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<LeadStatus>()" class="form-select"></select><span asp-validation-for="Status" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Score" class="form-label"></label><input asp-for="Score" class="form-control" min="0" max="100" /><span asp-validation-for="Score" class="text-danger"></span></div>
</div>
<div class="form-section-title mt-4"><span>Qualification &amp; ownership</span><small>Use a score and next action to keep momentum.</small></div>
<div class="row g-3">
    <div class="col-md-4"><label asp-for="EstimatedValue" class="form-label"></label><input asp-for="EstimatedValue" class="form-control" min="0" step="0.01" /><span asp-validation-for="EstimatedValue" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="NextFollowUpAt" class="form-label"></label><input asp-for="NextFollowUpAt" class="form-control" /><span asp-validation-for="NextFollowUpAt" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="LastContactedAt" class="form-label"></label><input asp-for="LastContactedAt" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="AssignedToUserId" class="form-label"></label><select asp-for="AssignedToUserId" asp-items="users" class="form-select"><option value="">Select assignee</option></select><span asp-validation-for="AssignedToUserId" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3" placeholder="Discovery notes, objections, next best action"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
</div>
