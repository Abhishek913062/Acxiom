@model Lead
@{ ViewData["Title"] = $"{Model.FirstName} {Model.LastName}"; }
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4"><div><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Leads</a><div class="d-flex align-items-center gap-3"><span class="profile-avatar">@Model.FirstName[..1].ToUpperInvariant()</span><div><h2>@Model.FirstName @Model.LastName</h2><p>@(Model.CompanyName ?? "Independent lead") · @(Model.Email ?? "No email")</p></div></div></div><div class="d-flex flex-wrap gap-2">@if(!Model.IsConverted && Model.Status != LeadStatus.Lost) { <a asp-action="Convert" asp-route-id="@Model.Id" class="btn btn-success"><i class="bi bi-arrow-repeat"></i> Convert to customer</a> }<a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Follow-up</a>@if(!Model.IsConverted) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a> }</div></div>
<section class="row g-4"><div class="col-lg-4"><article class="content-card h-100"><div class="card-heading"><div><h3>Lead details</h3><p><span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span></p></div></div><dl class="detail-list"><div><dt>Source</dt><dd>@Model.Source</dd></div><div><dt>Score</dt><dd><span class="score-pill">@Model.Score / 100</span></dd></div><div><dt>Estimated value</dt><dd>@(Model.EstimatedValue?.ToString("C0") ?? "Not set")</dd></div><div><dt>Phone</dt><dd>@(Model.Phone ?? "Not provided")</dd></div><div><dt>Owner</dt><dd>@(Model.AssignedToUser?.DisplayName ?? "Unassigned")</dd></div><div><dt>Next follow-up</dt><dd>@(Model.NextFollowUpAt?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") ?? "Not scheduled")</dd></div>@if(Model.IsConverted) { <div><dt>Converted</dt><dd>@Model.ConvertedAt?.ToLocalTime().ToString("dd MMM yyyy")</dd></div> }</dl>@if(!string.IsNullOrWhiteSpace(Model.Notes)) { <div class="note-box"><strong>Notes</strong><p>@Model.Notes</p></div> }</article></div><div class="col-lg-8"><article class="content-card mb-4"><div class="card-heading"><div><h3>Opportunities</h3><p>Potential revenue linked to this lead.</p></div><a asp-controller="Opportunities" asp-action="Create" asp-route-leadId="@Model.Id" class="text-link">Add opportunity <i class="bi bi-arrow-right"></i></a></div>@if(!Model.Opportunities.Any()) { <div class="empty-state compact"><i class="bi bi-kanban"></i><strong>No opportunities yet</strong><span>Add one once the lead enters a sales cycle.</span></div> } else { <div class="pipeline-list">@foreach(var item in Model.Opportunities) { <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.Id" class="pipeline-row"><span><strong>@item.Name</strong><small>@item.Stage · @item.Probability% probability</small></span><strong>@item.Amount.ToString("C0")</strong></a> }</div> }</article><article class="content-card"><div class="card-heading"><div><h3>Recent activity</h3><p>Notes and follow-ups for this lead.</p></div></div>@if(!Model.Activities.Any()) { <div class="empty-state compact"><i class="bi bi-clock-history"></i><strong>No activity yet</strong><span>Record a follow-up to preserve context.</span></div> } else { <div class="activity-list">@foreach(var item in Model.Activities) { <a asp-controller="Activities" asp-action="Details" asp-route-id="@item.Id" class="activity-row"><span class="activity-type"><i class="bi bi-check2-square"></i></span><span class="activity-copy"><strong>@item.Subject</strong><small>@item.Status · @item.CreatedAt.ToLocalTime().ToString("dd MMM")</small></span><span class="due-copy"><strong>@(item.DueAt?.ToLocalTime().ToString("dd MMM") ?? "—")</strong></span></a> }</div> }</article></div></section>
