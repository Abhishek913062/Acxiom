@model IEnumerable<Lead>
@{
    ViewData["Title"] = "Leads";
    var search = ViewData["Search"] as string;
    var selectedStatus = ViewData["Status"] as LeadStatus?;
    var selectedSource = ViewData["Source"] as LeadSource?;
}
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4"><div><span class="section-kicker"><i class="bi bi-person-lines-fill"></i> Customer management</span><h2>Leads</h2><p>Qualify each signal, act quickly, and convert when it is ready.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Add lead</a></div>
<section class="content-card"><form method="get" class="filter-bar"><div class="search-control"><i class="bi bi-search"></i><input name="search" type="search" value="@search" placeholder="Search lead, company, or email" /></div><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var option in Html.GetEnumSelectList<LeadStatus>()) { <option value="@option.Value" selected="@(option.Value == ((int?)selectedStatus)?.ToString())">@option.Text</option> }</select><select name="source" class="form-select"><option value="">All sources</option>@foreach(var option in Html.GetEnumSelectList<LeadSource>()) { <option value="@option.Value" selected="@(option.Value == ((int?)selectedSource)?.ToString())">@option.Text</option> }</select><button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel"></i> Filter</button></form><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>Lead</th><th>Source</th><th>Score</th><th>Status</th><th>Owner</th><th>Next follow-up</th><th class="text-end">Actions</th></tr></thead><tbody>@if(!Model.Any()) { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-person-plus"></i><strong>No leads found</strong><span>Add your first lead or adjust the filters.</span></div></td></tr> } @foreach(var lead in Model) { <tr><td><a asp-action="Details" asp-route-id="@lead.Id" class="table-primary-link"><span class="initial-avatar">@lead.FirstName[..1].ToUpperInvariant()</span><span><strong>@lead.FirstName @lead.LastName</strong><small>@(lead.CompanyName ?? lead.Email ?? "No company")</small></span></a></td><td>@lead.Source</td><td><span class="score-pill">@lead.Score</span></td><td><span class="status-badge status-@lead.Status.ToString().ToLowerInvariant()">@lead.Status</span></td><td>@(lead.AssignedToUser?.DisplayName ?? "Unassigned")</td><td>@(lead.NextFollowUpAt?.ToLocalTime().ToString("dd MMM, h:mm tt") ?? "—")</td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@lead.Id" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@lead.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></div></td></tr> }</tbody></table></div></section>
