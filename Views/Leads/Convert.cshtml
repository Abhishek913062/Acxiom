@model AcxiomCRM.ViewModels.LeadConversionViewModel
@{ ViewData["Title"] = "Convert lead"; var users = ViewData["AssignableUsers"] as SelectList; }
<div class="page-heading mb-4"><a asp-action="Details" asp-route-id="@Model.LeadId" class="back-link"><i class="bi bi-arrow-left"></i> Lead details</a><h2>Convert @Model.LeadName</h2><p>Create a customer record and preserve the original lead history.</p></div><form asp-action="Convert" method="post" class="content-card form-card"><input asp-for="LeadId" type="hidden" /><input asp-for="LeadName" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="alert alert-info"><i class="bi bi-info-circle-fill"></i> This action marks the lead as converted and links it to the new customer.</div><div class="row g-3"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<CustomerStatus>()" class="form-select"></select></div><div class="col-md-4"><label asp-for="OwnerId" class="form-label"></label><select asp-for="OwnerId" asp-items="users" class="form-select"></select><span asp-validation-for="OwnerId" class="text-danger"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div></div><div class="form-actions"><a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-light">Cancel</a><button class="btn btn-success" type="submit"><i class="bi bi-arrow-repeat"></i> Convert to customer</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
