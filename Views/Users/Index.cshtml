@model IEnumerable<AcxiomCRM.ViewModels.UserAdminViewModel>
@{ ViewData["Title"] = "Users"; var search = ViewData["Search"] as string; }
<div class="page-heading mb-4"><span class="section-kicker"><i class="bi bi-person-gear"></i> Administration</span><h2>User management</h2><p>Manage access, reporting lines, and account status without compromising security.</p></div><section class="content-card"><form method="get" class="filter-bar"><div class="search-control"><i class="bi bi-search"></i><input type="search" name="search" value="@search" placeholder="Search name or email" /></div><button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Search</button></form><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>User</th><th>Role</th><th>Manager</th><th>Last sign-in</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@if(!Model.Any()) { <tr><td colspan="6"><div class="empty-state"><i class="bi bi-person-x"></i><strong>No users found</strong><span>Try a different search.</span></div></td></tr> } @foreach(var user in Model) { <tr><td><div class="table-primary-link"><span class="initial-avatar">@user.Name[..1].ToUpperInvariant()</span><span><strong>@user.Name</strong><small>@user.Email</small></span></div></td><td>@foreach(var role in user.Roles) { <span class="status-badge status-prospect me-1">@role</span> }</td><td>@(user.ManagerName ?? "—")</td><td>@(user.LastLoginAt?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") ?? "Never")</td><td>@if(!user.IsActive) { <span class="status-badge status-lost">Inactive</span> } else if(user.IsLockedOut) { <span class="status-badge status-lost">Locked</span> } else { <span class="status-badge status-active">Active</span> }</td><td class="text-end"><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i> Manage</a></td></tr> }</tbody></table></div></section>
