@model AcxiomCRM.ViewModels.UserEditViewModel
@{ ViewData["Title"] = "Edit user"; var managers = ViewData["Managers"] as SelectList; var roles = ViewData["Roles"] as SelectList; }
<div class="page-heading mb-4"><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Users</a><h2>Edit user</h2><p>Update profile, reporting line, application role, and account state.</p></div><form asp-action="Edit" method="post" class="content-card form-card"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-section-title"><span>Profile &amp; access</span><small>Role changes are audited and immediately affect authorization.</small></div><div class="row g-3"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="JobTitle" class="form-label"></label><input asp-for="JobTitle" class="form-control" /></div><div class="col-md-4"><label asp-for="ManagerId" class="form-label"></label><select asp-for="ManagerId" asp-items="managers" class="form-select"><option value="">No manager</option></select><span asp-validation-for="ManagerId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Role" class="form-label"></label><select asp-for="Role" asp-items="roles" class="form-select"></select><span asp-validation-for="Role" class="text-danger"></span></div><div class="col-12"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" role="switch" /><label asp-for="IsActive" class="form-check-label"></label></div><small class="form-text">Inactive users cannot sign in; existing authentication is invalidated.</small></div></div><div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button class="btn btn-primary" type="submit"><i class="bi bi-shield-check"></i> Save access settings</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
