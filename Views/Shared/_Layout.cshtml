@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isManager = User.IsInRole("Manager");
    var displayName = User.Identity?.Name;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "Account";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AcxiomCRM - a secure customer relationship management platform." />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="crm-body">
    @if (isAuthenticated)
    {
        <div class="crm-shell">
            <aside class="crm-sidebar" id="crmSidebar" aria-label="Primary navigation">
                <div class="sidebar-brand">
                    <a asp-controller="Dashboard" asp-action="Index" class="brand-link" aria-label="AcxiomCRM dashboard">
                        <span class="brand-mark"><i class="bi bi-bar-chart-line-fill"></i></span>
                        <span>
                            <strong>Acxiom</strong><span>CRM</span>
                            <small>Sales intelligence</small>
                        </span>
                    </a>
                    <button class="btn sidebar-close d-lg-none" type="button" data-sidebar-close aria-label="Close navigation">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <nav class="sidebar-nav">
                    <span class="nav-label">Workspace</span>
                    <a class="sidebar-link" asp-controller="Dashboard" asp-action="Index" data-nav-link>
                        <i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
                    </a>

                    <span class="nav-label">Customer management</span>
                    <a class="sidebar-link" asp-controller="Customers" asp-action="Index" data-nav-link>
                        <i class="bi bi-people-fill"></i><span>Customers</span>
                    </a>
                    <a class="sidebar-link" asp-controller="Leads" asp-action="Index" data-nav-link>
                        <i class="bi bi-person-lines-fill"></i><span>Leads</span>
                    </a>

                    <span class="nav-label">Sales execution</span>
                    <a class="sidebar-link" asp-controller="Opportunities" asp-action="Index" data-nav-link>
                        <i class="bi bi-kanban-fill"></i><span>Opportunities</span>
                    </a>
                    <a class="sidebar-link" asp-controller="Activities" asp-action="Index" data-nav-link>
                        <i class="bi bi-calendar2-check-fill"></i><span>Follow-ups &amp; activities</span>
                    </a>

                    @if (isAdmin || isManager)
                    {
                        <span class="nav-label">Intelligence</span>
                        <a class="sidebar-link" asp-controller="Reports" asp-action="Index" data-nav-link>
                            <i class="bi bi-pie-chart-fill"></i><span>Reports</span>
                        </a>
                    }

                    @if (isAdmin)
                    {
                        <span class="nav-label">Administration</span>
                        <a class="sidebar-link" asp-controller="Users" asp-action="Index" data-nav-link>
                            <i class="bi bi-person-gear"></i><span>Users</span>
                        </a>
                        <a class="sidebar-link" asp-controller="Roles" asp-action="Index" data-nav-link>
                            <i class="bi bi-shield-lock-fill"></i><span>Roles &amp; access</span>
                        </a>
                        <a class="sidebar-link" asp-controller="AuditLogs" asp-action="Index" data-nav-link>
                            <i class="bi bi-journal-text"></i><span>Audit log</span>
                        </a>
                    }
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-help">
                        <span class="help-icon"><i class="bi bi-lightbulb-fill"></i></span>
                        <span><strong>Need a hand?</strong><small>Keep your pipeline current.</small></span>
                    </div>
                </div>
            </aside>
            <div class="sidebar-backdrop" data-sidebar-close></div>

            <main class="crm-main">
                <header class="crm-topbar">
                    <div class="topbar-leading">
                        <button class="btn sidebar-toggle d-lg-none" type="button" data-sidebar-toggle aria-label="Open navigation" aria-controls="crmSidebar">
                            <i class="bi bi-list"></i>
                        </button>
                        <div class="breadcrumb-context">
                            <span class="eyebrow">@ViewData["Section"]</span>
                            <h1>@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")</h1>
                        </div>
                    </div>
                    <div class="topbar-actions">
                        <span class="current-date d-none d-md-inline">@DateTime.Today.ToString("dddd, dd MMM")</span>
                        <div class="dropdown">
                            <button class="profile-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="avatar">@displayName.Substring(0, 1).ToUpperInvariant()</span>
                                <span class="profile-copy d-none d-sm-inline">
                                    <strong>@displayName</strong>
                                    <small>@(isAdmin ? "Administrator" : isManager ? "Manager" : "Sales Executive")</small>
                                </span>
                                <i class="bi bi-chevron-down d-none d-sm-inline"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end profile-menu">
                                <li><span class="dropdown-header">Signed in as<br /><strong>@displayName</strong></span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage"><i class="bi bi-person-circle"></i>My account</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key-fill"></i>Change password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right"></i>Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <div class="page-content container-fluid">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show app-alert" role="alert" data-auto-dismiss>
                            <i class="bi bi-check-circle-fill"></i><span>@successMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                            <i class="bi bi-exclamation-octagon-fill"></i><span>@errorMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["InfoMessage"] is string infoMessage)
                    {
                        <div class="alert alert-info alert-dismissible fade show app-alert" role="alert" data-auto-dismiss>
                            <i class="bi bi-info-circle-fill"></i><span>@infoMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
                <footer class="crm-footer">
                    <span>&copy; @DateTime.Now.Year AcxiomCRM</span>
                    <span class="footer-dot"></span>
                    <span>Built for better customer relationships</span>
                </footer>
            </main>
        </div>
    }
    else
    {
        <main class="auth-shell">
            <section class="auth-panel">
                <a asp-controller="Account" asp-action="Login" class="brand-link auth-brand" aria-label="AcxiomCRM home">
                    <span class="brand-mark"><i class="bi bi-bar-chart-line-fill"></i></span>
                    <span><strong>Acxiom</strong><span>CRM</span></span>
                </a>
                <div class="auth-content">
                    @if (TempData["SuccessMessage"] is string successMessage)
                    {
                        <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
                            <i class="bi bi-check-circle-fill"></i><span>@successMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                            <i class="bi bi-exclamation-octagon-fill"></i><span>@errorMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </section>
            <aside class="auth-aside d-none d-lg-flex">
                <div class="auth-orb auth-orb-one"></div>
                <div class="auth-orb auth-orb-two"></div>
                <div class="auth-aside-copy">
                    <span class="auth-kicker"><i class="bi bi-stars"></i> Smarter selling, every day</span>
                    <h2>Turn every customer conversation into momentum.</h2>
                    <p>AcxiomCRM gives your team the clarity to nurture opportunities, prioritize follow-ups, and close with confidence.</p>
                    <div class="auth-stat-row">
                        <div><strong>360&deg;</strong><span>customer view</span></div>
                        <div><strong>1</strong><span>connected workspace</span></div>
                    </div>
                </div>
            </aside>
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
