@model Activity
@{ ViewData["Title"] = Model.Subject; var related = Model.Customer?.DisplayName ?? Model.Lead?.CompanyName ?? (Model.Lead is not null ? Model.Lead.FirstName + " " + Model.Lead.LastName : null) ?? Model.Opportunity?.Name ?? "General activity"; }
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4"><div><a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Follow-ups &amp; activities</a><h2>@Model.Subject</h2><p>@Model.Type · @related</p></div><div class="d-flex gap-2">@if(Model.Status != ActivityStatus.Completed) { <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#completeActivity"><i class="bi bi-check-lg"></i> Mark complete</button> }<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a></div></div><section class="row g-4"><div class="col-lg-7"><article class="content-card h-100"><div class="card-heading"><div><h3>Activity details</h3><p><span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span> <span class="priority-badge priority-@Model.Priority.ToString().ToLowerInvariant()">@Model.Priority priority</span></p></div></div><dl class="detail-list"><div><dt>Type</dt><dd>@Model.Type</dd></div><div><dt>Related record</dt><dd>@related</dd></div><div><dt>Due</dt><dd>@(Model.DueAt?.ToLocalTime().ToString("dddd, dd MMM yyyy h:mm tt") ?? "No due date")</dd></div><div><dt>Assigned to</dt><dd>@(Model.AssignedToUser?.DisplayName ?? "Unassigned")</dd></div><div><dt>Completed</dt><dd>@(Model.CompletedAt?.ToLocalTime().ToString("dd MMM yyyy, h:mm tt") ?? "Not completed")</dd></div></dl>@if(!string.IsNullOrWhiteSpace(Model.Description)) { <div class="note-box"><strong>Description</strong><p>@Model.Description</p></div> }@if(!string.IsNullOrWhiteSpace(Model.Outcome)) { <div class="note-box mt-3"><strong>Outcome</strong><p>@Model.Outcome</p></div> }</article></div><div class="col-lg-5"><article class="content-card"><h3>Quick actions</h3><p class="text-muted">Update the task as the customer conversation progresses.</p><div class="d-grid gap-2"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Edit activity</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash3"></i> Delete activity</a></div></article></div></section>@if(Model.Status != ActivityStatus.Completed) { <div class="modal fade" id="completeActivity" tabindex="-1"><div class="modal-dialog"><form asp-action="Complete" method="post" class="modal-content"><div class="modal-header"><h5 class="modal-title">Complete activity</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input name="Id" value="@Model.Id" type="hidden" /><label class="form-label" for="Outcome">Outcome (optional)</label><textarea name="Outcome" id="Outcome" class="form-control" rows="3" placeholder="What happened? What is the next step?"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Complete</button></div></form></div></div> }
