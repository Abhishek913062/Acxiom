@model IEnumerable<Activity>
@{ ViewData["Title"] = "Follow-ups & activities"; var search = ViewData["Search"] as string; var status = ViewData["Status"] as ActivityStatus?; var type = ViewData["Type"] as ActivityType?; }
<div class="page-heading d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4"><div><span class="section-kicker"><i class="bi bi-calendar2-check-fill"></i> Sales execution</span><h2>Follow-ups &amp; activities</h2><p>Turn every commitment into a visible, accountable next action.</p></div><a asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> New follow-up</a></div><section class="content-card"><form method="get" class="filter-bar"><div class="search-control"><i class="bi bi-search"></i><input name="search" value="@search" type="search" placeholder="Search activity" /></div><select name="status" class="form-select"><option value="">All statuses</option>@foreach(var option in Html.GetEnumSelectList<ActivityStatus>()) { <option value="@option.Value" selected="@(option.Value == ((int?)status)?.ToString())">@option.Text</option> }</select><select name="type" class="form-select"><option value="">All types</option>@foreach(var option in Html.GetEnumSelectList<ActivityType>()) { <option value="@option.Value" selected="@(option.Value == ((int?)type)?.ToString())">@option.Text</option> }</select><button class="btn btn-outline-secondary"><i class="bi bi-funnel"></i> Filter</button></form><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>Activity</th><th>Related to</th><th>Priority</th><th>Status</th><th>Due</th><th>Owner</th><th class="text-end">Actions</th></tr></thead><tbody>@if(!Model.Any()) { <tr><td colspan="7"><div class="empty-state"><i class="bi bi-calendar-check"></i><strong>No activities found</strong><span>Create a follow-up to keep the next action visible.</span></div></td></tr> } @foreach(var item in Model) { var related = item.Customer?.DisplayName ?? item.Lead?.CompanyName ?? item.Opportunity?.Name ?? "General"; <tr><td><a asp-action="Details" asp-route-id="@item.Id" class="table-primary-link"><span class="initial-avatar"><i class="bi @(item.Type == ActivityType.Call ? "bi-telephone-fill" : item.Type == ActivityType.Email ? "bi-envelope-fill" : "bi-check2-square")"></i></span><span><strong>@item.Subject</strong><small>@item.Type</small></span></a></td><td>@related</td><td><span class="priority-badge priority-@item.Priority.ToString().ToLowerInvariant()">@item.Priority</span></td><td><span class="status-badge status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span></td><td class="@(item.IsOverdue ? "text-danger fw-semibold" : "")">@(item.DueAt?.ToLocalTime().ToString("dd MMM, h:mm tt") ?? "—")</td><td>@(item.AssignedToUser?.DisplayName ?? "Unassigned")</td><td class="text-end"><div class="table-actions"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light"><i class="bi bi-eye"></i></a><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i></a></div></td></tr> }</tbody></table></div></section>
