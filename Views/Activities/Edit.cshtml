@model Activity
@{ ViewData["Title"] = "Edit activity"; }
<div class="page-heading mb-4"><a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i> Activity details</a><h2>Edit activity</h2><p>Keep the next action, owner, and result current.</p></div><form asp-action="Edit" method="post" class="content-card form-card"><partial name="_ActivityForm" model="Model" /><div class="form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a><button class="btn btn-primary" type="submit"><i class="bi bi-check-lg"></i> Save changes</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
