@model Activity
@{ ViewData["Title"] = "Delete activity"; }
<div class="page-heading mb-4"><a asp-action="Details" asp-route-id="@Model.Id" class="back-link"><i class="bi bi-arrow-left"></i> Activity details</a><h2>Delete activity</h2><p>This action cannot be undone.</p></div><section class="content-card danger-card narrow-card"><i class="bi bi-exclamation-triangle-fill danger-icon"></i><h3>Delete @Model.Subject?</h3><p>This will permanently remove the activity record from the timeline.</p><form asp-action="Delete" method="post" class="form-actions"><input asp-for="Id" type="hidden" /><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">Cancel</a><button class="btn btn-danger" type="submit"><i class="bi bi-trash3"></i> Delete activity</button></form></section>
