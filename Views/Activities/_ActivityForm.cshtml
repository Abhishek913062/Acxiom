@model Activity
@{ var customers = ViewData["Customers"] as SelectList; var leads = ViewData["Leads"] as SelectList; var opportunities = ViewData["Opportunities"] as SelectList; var users = ViewData["AssignableUsers"] as SelectList; }
<input asp-for="Id" type="hidden" /><input asp-for="RowVersion" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-section-title"><span>Activity details</span><small>Document the next action and connect it to CRM context.</small></div><div class="row g-3"><div class="col-md-8"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" placeholder="e.g. Confirm technical requirements" /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<ActivityType>()" class="form-select"></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3" placeholder="What is needed, who is involved, and what good looks like"></textarea></div><div class="col-md-4"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" asp-items="customers" class="form-select"><option value="">No customer</option></select></div><div class="col-md-4"><label asp-for="LeadId" class="form-label">Lead</label><select asp-for="LeadId" asp-items="leads" class="form-select"><option value="">No lead</option></select></div><div class="col-md-4"><label asp-for="OpportunityId" class="form-label">Opportunity</label><select asp-for="OpportunityId" asp-items="opportunities" class="form-select"><option value="">No opportunity</option></select></div></div><div class="form-section-title mt-4"><span>Schedule &amp; outcome</span><small>Choose an owner and close the loop when work is done.</small></div><div class="row g-3"><div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ActivityStatus>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<ActivityPriority>()" class="form-select"></select></div><div class="col-md-3"><label asp-for="DueAt" class="form-label"></label><input asp-for="DueAt" class="form-control" /></div><div class="col-md-3"><label asp-for="AssignedToUserId" class="form-label"></label><select asp-for="AssignedToUserId" asp-items="users" class="form-select"><option value="">Select assignee</option></select><span asp-validation-for="AssignedToUserId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Outcome" class="form-label"></label><textarea asp-for="Outcome" class="form-control" rows="2" placeholder="Add the result when completed"></textarea></div><div class="col-md-6"><label asp-for="CompletedAt" class="form-label"></label><input asp-for="CompletedAt" class="form-control" /><small class="form-text">Set automatically for a completed activity.</small></div></div>
