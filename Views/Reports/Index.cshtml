@using System.Text.Json
@model AcxiomCRM.ViewModels.ReportsViewModel
@{ ViewData["Title"] = "Reports"; var customerLabels = JsonSerializer.Serialize(Model.CustomersByStatus.Select(x => x.Label)); var customerValues = JsonSerializer.Serialize(Model.CustomersByStatus.Select(x => x.Count)); var leadLabels = JsonSerializer.Serialize(Model.LeadsBySource.Select(x => x.Label)); var leadValues = JsonSerializer.Serialize(Model.LeadsBySource.Select(x => x.Count)); var pipelineLabels = JsonSerializer.Serialize(Model.PipelineByStage.Select(x => x.Label)); var pipelineValues = JsonSerializer.Serialize(Model.PipelineByStage.Select(x => x.Amount)); }
<div class="page-heading mb-4"><span class="section-kicker"><i class="bi bi-pie-chart-fill"></i> Intelligence</span><h2>Sales reports</h2><p>Understand customers, lead quality, sales execution, follow-ups, and pipeline health.</p></div><section class="metric-grid mb-4"><article class="metric-card metric-blue"><span class="metric-icon"><i class="bi bi-people-fill"></i></span><div><span class="metric-label">Customers</span><strong>@Model.TotalCustomers.ToString("N0")</strong><small>Across your accessible portfolio</small></div></article><article class="metric-card metric-violet"><span class="metric-icon"><i class="bi bi-person-lines-fill"></i></span><div><span class="metric-label">Open leads</span><strong>@Model.OpenLeads.ToString("N0")</strong><small>Still in qualification</small></div></article><article class="metric-card metric-teal"><span class="metric-icon"><i class="bi bi-cash-stack"></i></span><div><span class="metric-label">Open pipeline</span><strong>@Model.OpenPipeline.ToString("C0")</strong><small>@Model.WonRevenue.ToString("C0") total won</small></div></article><article class="metric-card metric-amber"><span class="metric-icon"><i class="bi bi-calendar2-check-fill"></i></span><div><span class="metric-label">Pending follow-ups</span><strong>@Model.PendingActivities.ToString("N0")</strong><small>Open customer commitments</small></div></article></section><section class="row g-4"><div class="col-lg-6"><article class="content-card chart-card h-100"><div class="card-heading"><div><h3>Customer report</h3><p>Customer distribution by relationship status.</p></div></div><div class="chart-wrap"><canvas id="customerReport"></canvas></div></article></div><div class="col-lg-6"><article class="content-card chart-card h-100"><div class="card-heading"><div><h3>Lead report</h3><p>Where your incoming demand comes from.</p></div></div><div class="chart-wrap"><canvas id="leadSourceReport"></canvas></div></article></div><div class="col-12"><article class="content-card"><div class="card-heading"><div><h3>Sales &amp; pipeline report</h3><p>Deal volume, value, and weighted forecast by stage.</p></div></div><div class="table-responsive"><table class="table app-table align-middle mb-0"><thead><tr><th>Stage</th><th>Opportunities</th><th>Pipeline value</th><th>Weighted forecast</th></tr></thead><tbody>@if(!Model.PipelineByStage.Any()) { <tr><td colspan="4"><div class="empty-state compact"><i class="bi bi-bar-chart"></i><strong>No pipeline data yet</strong><span>Create opportunities to unlock sales reporting.</span></div></td></tr> } @foreach(var item in Model.PipelineByStage) { <tr><td><span class="status-badge status-@item.Label.ToLowerInvariant()">@item.Label</span></td><td>@item.Count</td><td>@item.Amount.ToString("C2")</td><td>@item.WeightedAmount.ToString("C2")</td></tr> }</tbody></table></div></article></div><div class="col-lg-6"><article class="content-card"><div class="card-heading"><div><h3>Lead status report</h3><p>Qualification outcomes at a glance.</p></div></div><div class="report-list">@foreach(var item in Model.LeadsByStatus) { <div class="report-row"><span>@item.Label</span><strong>@item.Count</strong></div> }</div></article></div><div class="col-lg-6"><article class="content-card"><div class="card-heading"><div><h3>Follow-up report</h3><p>Open versus completed activities.</p></div></div><div class="report-list">@foreach(var item in Model.ActivitiesByStatus) { <div class="report-row"><span>@item.Label</span><strong>@item.Count</strong></div> }</div></article></div></section>
@section Scripts { <script>(() => { const palette=['#5b6cf0','#8b5cf6','#0ea5a4','#f59e0b','#ec4899','#22c55e','#94a3b8']; const chart=(id, labels, data, type='doughnut')=>{const el=document.getElementById(id);if(el&&window.Chart)new Chart(el,{type,data:{labels,datasets:[{data,backgroundColor:palette,borderWidth:0,borderRadius:type==='bar'?7:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:type==='bar'?'top':'bottom',labels:{usePointStyle:true,boxWidth:8}}},scales:type==='bar'?{x:{grid:{display:false}},y:{beginAtZero:true}}:{}}});}; chart('customerReport', @Html.Raw(customerLabels), @Html.Raw(customerValues)); chart('leadSourceReport', @Html.Raw(leadLabels), @Html.Raw(leadValues), 'bar'); })();</script> }
